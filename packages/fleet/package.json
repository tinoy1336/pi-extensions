{
	"name": "@tinoy/pi-fleet",
	"version": "0.1.0",
	"description": "A fleet of long-lived worker sessions driven by one coordinating session, and the write coordination that guards one shared tree: per-worker claims, locks and version checks.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tinoy1336/pi-extensions.git",
		"directory": "packages/fleet"
	},
	"homepage": "https://github.com/tinoy1336/pi-extensions/tree/main/packages/fleet#readme",
	"bugs": {
		"url": "https://github.com/tinoy1336/pi-extensions/issues"
	},
	"type": "module",
	"main": "fleet/index.ts",
	"keywords": [
		"pi-package"
	],
	"files": [
		"fleet/adopt.ts",
		"fleet/board.ts",
		"fleet/index.ts",
		"fleet/items.ts",
		"fleet/launch.ts",
		"fleet/mode.ts",
		"fleet/predicates.ts",
		"fleet/release.ts",
		"fleet/retire.ts",
		"fleet/roster.ts",
		"fleet/section.ts",
		"fleet/status.ts",
		"io-guard/claims.ts",
		"io-guard/identity.ts",
		"io-guard/index.ts",
		"io-guard/locks.ts",
		"io-guard/pend.ts",
		"io-guard/predicates.ts",
		"io-guard/reap.ts",
		"io-guard/versions.ts",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./fleet/index.ts",
			"./io-guard/index.ts"
		]
	},
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*",
		"@juicesharp/rpiv-todo": "*"
	},
	"dependencies": {
		"@tinoy/pi-ext-lib": "*",
		"@tinoy/pi-tariff": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-todo": {
			"optional": true
		}
	}
}
